	if _defs == null:
		_defs = Fx.arbor()
	return _defs


func _reject_doc(doc: Dictionary, defs: GameDefs, needle: String, label: String) -> void:
	var r := SaveCodec.decode(JSON.stringify(doc), defs)
	check(not r.ok() and r.state == null, "%s: 거부되어야 한다" % label)
	check(r.error.contains(needle), "%s: 이유 '%s' 기대, 실제 '%s'" % [label, needle, r.error])


func _reject(s: ExplorationState, mutate: Callable, needle: String, label: String) -> void:
	var doc: Dictionary = JSON.parse_string(SaveCodec.encode(s))
	mutate.call(doc)
	_reject_doc(doc, s.defs, needle, label)


## 저장 → 읽기가 되고 같은 상태 해시(전투 중이면 전투 해시도)인지. 읽은 상태.
func _roundtrip(s: ExplorationState, label: String) -> ExplorationState:
	var r := SaveCodec.decode(SaveCodec.encode(s), s.defs)
	check(r.ok() and r.from_schema == 13, "%s: 읽기 %s" % [label, r.error])
	if not r.ok():
		return null
	check_eq(SaveCodec.state_hash(r.state), SaveCodec.state_hash(s), "%s: 같은 상태 해시" % label)
	if s.battle != null:
		check_eq(Fx.battle_hash(r.state), Fx.battle_hash(s), "%s: 같은 전투 해시" % label)
	return r.state


## B3F 칸 at·facing 의 미궁 상태(permit.boss 는 보고 없이 가진다: 12판이 받는 「보고 없는 허가」). open 이면 봉인이 열렸다.
func _b3f(at: Vector2i, facing: int, open: bool, flag: bool = true) -> ExplorationState:
	var s := ExplorationRules.new_game(_arbor(), 7, "full")
	Fx.to_floor(s, "b3f", at, facing)
	if flag:
		s.flags["permit.boss"] = true
	if open:
		s.world.open_lock(SEAL)
	return s


## S1 (M-S2 migrate_v12 가 12판 검사를 건너뜀은 S2 가 본다): 12판 고정 문서 다섯이 13판으로 옮겨진다. B3F 기록이 있으면 보스 기록이 처음 상태로 더해지고
## 그것을 빼면 원래 상태와 같다. 13판으로 다시 쓰고 읽어도 같은 해시.
func test_fixed_v12_to_v13() -> void:
	var game := _arbor()
	for x in [["V12_TOWN", V12_TOWN, "town", true], ["V12_SEAL", V12_SEAL, "labyrinth", true], ["V12_CONTACT", V12_CONTACT, "labyrinth", true],
			["V12_WIPED", V12_WIPED, "labyrinth", true], ["V12_QUESTS", V12_QUESTS, "labyrinth", false]]:
		var orig: Dictionary = JSON.parse_string(x[1])
		var r := SaveCodec.decode(x[1], game)
		check(r.ok(), "%s: 읽기 %s" % [x[0], r.error])
		if not r.ok():
			continue
		check_eq([r.from_schema, r.relocated, r.saved_at, r.generation, r.state.location], [12, false, orig["saved_at"], int(orig["generation"]), x[2]],
			"%s: 12판·옮김 없음·saved_at·generation·장소" % x[0])
		var now := SaveCodec.state_to_dict(r.state)
		check_eq(now["floor_states"].has("b3f"), x[3], "%s: B3F 기록 있음 %s" % [x[0], str(x[3])])
		if x[3]:
			check_eq(now["floor_states"]["b3f"]["world"]["foes"]["boss"], {"at": [4, 2], "facing": "E", "state": "idle", "path_i": 0, "dir": 1, "stun": 0, "day": 0},
				"%s: 더한 보스 기록" % x[0])
		var sv := Fx.strip_v13(now, game)
		check_eq(sv["bad"], "", "%s: 보스 기록은 처음 상태" % x[0])
		var o: Dictionary = orig["state"]
		for k in o:
			check_eq(V7._norm(sv["state"][k]), V7._norm(o[k]), "%s: %s 보존" % [x[0], k])
		check_eq(sv["state"].keys().filter(func(k: String) -> bool: return not o.has(k)), [], "%s: 맨 위에 더한 필드 없음" % x[0])
		var doc: Dictionary = JSON.parse_string(SaveCodec.encode(r.state))
		var again := SaveCodec.decode(JSON.stringify(doc), game)
		check(doc["schema"] == 13.0 and doc["rules"] == "m3b" and again.ok() and again.from_schema == 13 and SaveCodec.state_hash(again.state) == SaveCodec.state_hash(r.state),
			"%s: 13판으로 쓰고 다시 읽기 같은 해시 %s" % [x[0], again.error])
	var seal := SaveCodec.decode(V12_SEAL, game).state
	if seal != null:
		check_eq([seal.party.at, seal.party.facing, seal.flags.has("permit.boss"), seal.world.is_lock_open(SEAL), FoeRules.cleared(seal)],
			[Vector2i(9, 2), Dir.W, true, false, [] as Array[String]], "옮긴 봉인 앞: 허가 있음, 봉인 닫힘, 클리어 아님")


## S2 (M-S2 migrate_v12 가 12판 검사를 건너뜀, M-S4 12판에 보스 기록을 받음): 12판 문서는 12판 규칙으로 검사한다: 봉인은 열릴 수 없고 보스 기록은 없다.
## 판과 규칙 이름이 어긋나면 거부.
func test_v12_rules_still_apply() -> void:
	var game := _arbor()
	var d: Dictionary = JSON.parse_string(V12_SEAL)
	d["state"]["floor_states"]["b3f"]["world"]["locks_open"].append("v:9:2")
	_reject_doc(d, game, "12판 검사 실패: floor_states.b3f.world.locks_open: v:9:2 는 봉인 문이라 열릴 수 없다", "12판 봉인 열림")
	var b: Dictionary = JSON.parse_string(V12_SEAL)
	b["state"]["floor_states"]["b3f"]["world"]["foes"]["boss"] = {"at": [4, 2], "facing": "E", "state": "idle", "path_i": 0, "dir": 1, "stun": 0, "day": 0}
	_reject_doc(b, game, "12판 검사 실패: floor_states.b3f.world.foes.boss: 12판 저장에는 보스 기록이 있을 수 없다", "12판 보스 기록")
	var m: Dictionary = JSON.parse_string(V12_SEAL)
	m["rules"] = "m3b"
	_reject_doc(m, game, "rules", "12판 + m3b")
	var n: Dictionary = JSON.parse_string(SaveCodec.encode(_b3f(Vector2i(9, 2), Dir.W, false)))
	n["rules"] = "m3q"
	_reject_doc(n, game, "rules", "13판 + m3q")
	n["rules"] = "m3b"
	n["schema"] = 14
	_reject_doc(n, game, "schema", "다음 판 14")


## S3 (M-S1 플래그 없이 연 봉인을 받음, M-S3 FOE_STATES.boss 가 patrol 을 받음, M-S5 보스 자리 검사를 지움): 13판 받기·거부.
func test_v13_accepts_and_rejects() -> void:
	# 받기: 연 봉인 + 플래그(방 안), 보스 idle·defeated, 클리어 상태.
	var open := _b3f(Vector2i(6, 2), Dir.W, true)
	_roundtrip(open, "연 봉인 + 플래그, 방 안")
	var cleared := _b3f(Vector2i(6, 2), Dir.W, true)
	cleared.world.foes["boss"].state = "defeated"
	cleared.world.foes["boss"].day = 1
	var cr := _roundtrip(cleared, "보스 쓰러짐(클리어)")
	if cr != null:
		check_eq(FoeRules.cleared(cr), ["b3f"] as Array[String], "읽은 클리어 기록")
	# 거부.
	_reject(open, func(d): d["state"]["flags"] = ["permit.b2f"], "floor_states.b3f.world.locks_open: 봉인 v:9:2 를 여는 플래그 permit.boss 가 없다", "플래그 없이 연 봉인")
	_reject(open, func(d): d["state"]["floor_states"]["b3f"]["world"]["foes"]["boss"]["state"] = "patrol", "world.foes.boss.state: boss FOE 가 가질 수 없는 상태다", "보스 patrol")
	_reject(open, func(d): d["state"]["floor_states"]["b3f"]["world"]["foes"]["boss"]["state"] = "return", "boss FOE 가 가질 수 없는 상태다", "보스 return")
	_reject(open, func(d): d["state"]["floor_states"]["b3f"]["world"]["foes"]["boss"]["at"] = [5, 1], "world.foes.boss: 보스는 처음 자리 4:2·방향 E 그대로여야 한다", "보스 자리 옮김")
	_reject(open, func(d): d["state"]["floor_states"]["b3f"]["world"]["foes"]["boss"]["facing"] = "W", "보스는 처음 자리 4:2·방향 E 그대로여야 한다", "보스 방향")
	_reject(open, func(d): d["state"]["floor_states"]["b3f"]["world"]["foes"]["boss"]["state"] = "defeated", "world.foes.boss.day: 쓰러진 FOE 는 정수", "쓰러졌는데 day 0")
	# 없는 FOE 기록은 처음 상태로 둔다(10판부터의 규칙, 12판 → 13판 이전이 보스를 더하는 길): 보스 기록이 빠진 13판도 처음 상태 보스로 읽힌다.
	var nd: Dictionary = JSON.parse_string(SaveCodec.encode(open))
	nd["state"]["floor_states"]["b3f"]["world"]["foes"].erase("boss")
	var nr := SaveCodec.decode(JSON.stringify(nd), open.defs)
	check(nr.ok() and nr.state.world.foes["boss"].state == "idle" and nr.state.world.foes["boss"].at == Vector2i(4, 2), "보스 기록 없음: 처음 상태로 채움 %s" % nr.error)
	# needs 없는 봉인은 13판에서도 열릴 수 없다(시험 층).
	var f := Fx.floor_of(["+-+-+-+-+-+", "|. . .K. .|", "+-+-+-+-+-+"], {"locks": [{"at": [2, 0], "dir": "E", "seal": "boss"}]})
	var t := ExplorationRules.new_game(Fx.defs(f), 1, "full")
	_reject(t, func(d): d["state"]["floor_states"]["fx"]["world"]["locks_open"] = ["v:3:0"], "world.locks_open: v:3:0 는 봉인 문이라 열릴 수 없다", "needs 없는 봉인 열림")


## 보스 전투 중 상태: 연 봉인 방 (5,2) 에서 FIGHT.
func _boss_battle(seed_value: int = 3) -> ExplorationState:
	var s := _b3f(Vector2i(5, 2), Dir.W, true)
	s.rng = GameRng.new(seed_value)
	var ev := ExplorationRules.apply(s, A.FIGHT, "full")
	assert(ev[-1]["type"] == "encounter")
	return s


## S4 (M-S6 보스 battle 상태를 battle.foe 없이 받음): 보스 전투 중 저장(적 강화·충전이 든), 전멸 뒤 저장. battle.foe 가 없으면 거부.
func test_boss_battle_saves() -> void:
	var s := _boss_battle()
	var u: BattleUnit = s.battle.enemies[0]
	var ev: Array[Dictionary] = []
	BattleEffects.apply_effect(s.battle, s.defs.battle.rules, u, s.defs.battle.skills["skill.enemy.overclock"], 1, ev)
	u.charging = "skill.enemy.thunder_lunge"
	check_eq([u.buffs.size(), s.world.foes["boss"].state, s.battle.foe], [1, "battle", "boss"], "준비: 강화·충전·보스 battle")
	_roundtrip(s, "보스 전투 중(강화·충전)")
	_reject(s, func(d): d["state"]["battle"].erase("foe"), "전투 대기(pending)와 위험도 >= 한계값이 맞지 않다", "battle.foe 없는 보스 전투(접촉 전투는 위험도를 쓰지 않음)")
	_reject(s, func(d):
		d["state"]["battle"].erase("foe")
		d["state"]["encounter"]["danger"] = d["state"]["encounter"]["threshold"], "battle", "battle.foe 없는 보스 전투(위험도를 맞춤)")
	_reject(s, func(d): d["state"]["floor_states"]["b3f"]["world"]["foes"]["boss"]["state"] = "idle", "battle", "전투 중인데 보스 idle")
	var w := _boss_battle()
	for m in w.party.members:
		m.hp = 1
	var n := 0
	while w.battle != null and n < 100:
		BattleRules.submit(w, BattlePolicy.choose(w, "default"))
		n += 1
	check_eq([w.wiped, w.world.foes["boss"].state], [true, "idle"], "준비: 보스에게 전멸")
	_roundtrip(w, "보스에게 전멸 뒤")


## S5 (조정자 조건 1, M-S7 닫힌 봉인 뒤 파티 검사를 지움, M-S8 봉인 뒤 칸을 정확히 세지 않음): 닫힌 봉인 뒤 칸에 선 미궁 파티는 거부(영영 갇힘).
## 봉인이 열렸거나, 봉인 앞이거나, 마을이면 받는다.
func test_sealed_room_soft_lock() -> void:
	var inside := _b3f(Vector2i(6, 2), Dir.W, false)
	_reject(inside, func(d): pass, "party.at: 6:2 는 닫힌 봉인 v:9:2 뒤 칸이라 나올 수 없다", "닫힌 봉인 뒤(플래그 있음)")
	_reject(_b3f(Vector2i(8, 3), Dir.N, false, false), func(d): pass, "party.at: 8:3 는 닫힌 봉인 v:9:2 뒤 칸이라", "닫힌 봉인 뒤(플래그 없음)")
	for c in [Vector2i(3, 1), Vector2i(8, 1), Vector2i(4, 3)]:
		_reject(_b3f(c, Dir.N, false), func(d): pass, "는 닫힌 봉인 v:9:2 뒤 칸이라 나올 수 없다", "방 모서리 %s" % str(c))
	_roundtrip(_b3f(Vector2i(6, 2), Dir.W, true), "봉인이 열린 방 안")
	_roundtrip(_b3f(Vector2i(9, 2), Dir.W, false), "닫힌 봉인 앞(밖)")
	var town := _b3f(Vector2i(6, 2), Dir.W, false)
	Fx.to_town(town)
	_roundtrip(town, "마을(B3F 기록의 봉인은 닫힘)")
	# 정상 플레이로는 닫힌 봉인 뒤에 설 수 없다: 열린 봉인을 지나서만 들어가고 봉인은 다시 닫히지 않는다(R1). 그래서 거부는 손댄 저장만 막는다.


## S5 역증명(조정자 조건 1, M-S8): 실제 이동 규칙으로 B3F 를 너비 우선으로 걷는다(봉인만 닫고 지름길·열쇠 문은 열고 FOE·인카운트는 끔).
## 계단에서 닿는 칸 = 봉인 뒤가 아닌 칸 전부이고, 봉인 뒤 칸 어디서 걸어도 방 밖으로 나가지 못한다. 그래서 behind_seal 거부는 정확하다(넘치지도 모자라지도 않는다).
func test_soft_lock_reverse_proof() -> void:
	var defs := _arbor()
	var f := defs.floor_by_id("b3f")
	var behind: Dictionary = f.behind_seal[SEAL]
	check_eq(behind.size(), 18, "준비: 봉인 뒤 칸 18")
	var s := ExplorationRules.new_game(defs, 1, "full")
	Fx.to_floor(s, "b3f", Vector2i(17, 18), Dir.N)
	for e in f.edges_of_kind(FloorModel.Edge.SHORTCUT):
		s.world.open_shortcut(e)
	for e in f.edges_of_kind(FloorModel.Edge.LOCK):
		if e != SEAL:
			s.world.open_lock(e)
	var was := FoeRules.enabled
	FoeRules.enabled = false
	for id in s.world.foes:
		s.world.foes[id].state = "defeated"  # 부딪힘 접촉(경비기)·보스 물음 없이 칸만 본다
		s.world.foes[id].day = 1
	var from_stairs := _reach(s, [Vector2i(17, 18)])
	var all_cells := {}
	for c in f.cells():
		all_cells[c] = true
	var outside := {}
	for c in all_cells:
		if not behind.has(c):
			outside[c] = true
	var missing := outside.keys().filter(func(c: Vector2i) -> bool: return not from_stairs.has(c))
	var extra := from_stairs.keys().filter(func(c: Vector2i) -> bool: return not outside.has(c))
	check_eq([missing, extra, from_stairs.size()], [[], [], outside.size()], "계단에서 닿는 칸 = 봉인 뒤가 아닌 칸 전부(%d)" % outside.size())
	var from_room := _reach(s, behind.keys())
	check_eq(from_room, behind, "봉인 뒤 칸에서는 방 밖으로 나가지 못한다")
	FoeRules.enabled = was
	check(not s.world.is_lock_open(SEAL), "걷는 동안 봉인은 닫힌 채(플래그 없음)")


## 칸들에서 시작해 실제 이동(앞·뒤·옆·회전)으로 닿는 칸(멈춘 칸과 미끄러져 지나간 칸). 위치·방향만 바꾸고 걸음마다 위험도·HP 를 되돌린다.
func _reach(s: ExplorationState, starts: Array) -> Dictionary:
	var seen := {}
	var cells := {}
	var queue: Array = []
	for c in starts:
		for d in 4:
			queue.append([c, d])
			seen[[c, d]] = true
		cells[c] = true
	var head := 0
	while head < queue.size():
		var node: Array = queue[head]
		head += 1
		for a in [A.FORWARD, A.BACK, A.STRAFE_LEFT, A.STRAFE_RIGHT, A.TURN_LEFT, A.TURN_RIGHT]:
			s.party.at = node[0]
			s.party.facing = node[1]
			s.encounter.danger = 0
			s.encounter.threshold = 1000000
			for m in s.party.members:
				m.hp = m.max_hp
			for e in ExplorationRules.apply(s, a, "full"):
				if e["type"] == "moved":
					cells[e["to"]] = true  # 얼음 위로 미끄러져 지나간 칸도 닿은 칸이다(분석의 touched 와 같다)
			check(s.battle == null and not s.encounter.pending, "걷는 동안 전투 없음")
			var key := [s.party.at, s.party.facing]
			if not seen.has(key):
				seen[key] = true
				cells[s.party.at] = true
				queue.append(key)
	return cells


## S6 (교훈 1, 조정자 조건 1): 옮긴 V12_SEAL 에서 실제 행동마다 저장 → 읽기: 봉인 열기 → 방으로 → 보스에 부딪힘 → FIGHT(전투 중) → 승리 → 클리어.
func test_action_save_reload_chain() -> void:
	var r := SaveCodec.decode(V12_SEAL, _arbor())
	check(r.ok(), "옮긴 V12_SEAL %s" % r.error)
	if not r.ok():
		return
	var s := r.state
	var steps := [[A.FORWARD, "seal_opened", Vector2i(9, 2)], [A.FORWARD, "moved", Vector2i(8, 2)], [A.FORWARD, "moved", Vector2i(7, 2)],
		[A.FORWARD, "moved", Vector2i(6, 2)], [A.FORWARD, "moved", Vector2i(5, 2)], [A.FORWARD, "boss", Vector2i(5, 2)], [A.FIGHT, "encounter", Vector2i(5, 2)]]
	for st in steps:
		var ev := ExplorationRules.apply(s, st[0], "full")
		check(Fx.types(ev).has(st[1]), "%s: %s 이벤트 %s" % [str(st[2]), st[1], str(Fx.types(ev))])
		check_eq(s.party.at, st[2], "%s 자리" % st[1])
		var back := _roundtrip(s, "%s 뒤 저장" % st[1])
		if back != null:
			s = back
	var fin: Array[Dictionary] = []
	check(BattleRules.finish(s, "victory", fin), "승리로 끝냄")
	var end := _roundtrip(s, "승리 뒤 저장")
	if end != null:
		check_eq([FoeRules.cleared(end), end.world.foes["boss"].state, end.world.is_lock_open(SEAL)], [["b3f"] as Array[String], "defeated", true], "읽은 클리어 상태")
