## M-S4(_read_consumables 를 건너뜀): 소모품을 쓰고 읽으면 같은 해시, 머리 8판.
func test_v8_roundtrip_with_consumables() -> void:
	var s := ExplorationRules.new_game(Fx.defs(), 5, "floor")
	s.consumables = {"use.medica": 3, "use.ariadne_beacon": 1, "use.theriaca_b": 99}
	var doc: Dictionary = JSON.parse_string(SaveCodec.encode(s))
	check_eq([doc["schema"], doc["rules"], doc["state"]["consumables"]], [10.0, "m3o", {"use.medica": 3.0, "use.ariadne_beacon": 1.0, "use.theriaca_b": 99.0}], "10판 머리·consumables")
	var r := SaveCodec.decode(SaveCodec.encode(s), s.defs)
	check(r.ok(), "읽기 %s" % r.error)
	if r.ok():
		check_eq([r.state.consumables, r.from_schema, SaveCodec.state_hash(r.state)], [s.consumables, 10, SaveCodec.state_hash(s)], "같은 소모품·10판·같은 해시")


## M-S5(shop.bought 가 장비 ID 만 받음): 상점에서 소모품을 사면(ShopRules.buy, NEW 를 끄려고 bought 에 남는다) 그 상태를 쓰고 다시 읽을 수 있다.
## 웹 부분 E 가 찾은 실패(A4b): 사고 난 뒤 자동 저장이 「shop.bought 의 use.medica 는 모르는 장비다」로 실패했다.
func test_v8_roundtrip_after_buying_consumables() -> void:
	var s := ExplorationRules.new_game(Fx.defs(), 5, "floor")
	s.money = 1000
	for id in ["use.medica", "use.ariadne_beacon"]:
		check_eq(ShopRules.buy(s, JUNK, id, 2)[0]["type"], "bought", "준비: %s 사기" % id)
	check(s.shop.bought.has("use.medica") and s.shop.bought.has("use.ariadne_beacon"), "준비: bought 에 소모품")
	var r := SaveCodec.decode(SaveCodec.encode(s), s.defs)
	check(r.ok(), "읽기 %s" % r.error)
	if r.ok():
		check_eq([r.state.shop.bought_list(), SaveCodec.state_hash(r.state)], [s.shop.bought_list(), SaveCodec.state_hash(s)], "같은 bought·같은 해시")


## M-S3(범위 1~9,999).
func test_v8_rejects_bad_consumables() -> void:
	var s := ExplorationRules.new_game(Fx.defs(), 5, "floor")
	s.consumables = {"use.medica": 3}
	_reject(s, func(d): d["state"]["consumables"]["use.nope"] = 1, "consumables 의 use.nope 는 모르는 소모품이다", "모르는 ID")
	_reject(s, func(d): d["state"]["consumables"]["item.neon_rat_tail"] = 1, "consumables 의 item.neon_rat_tail 는 모르는 소모품이다", "소재 ID")
	for bad in [0, 100, 1.5, true, "3", -1, null]:
		_reject(s, func(d): d["state"]["consumables"]["use.medica"] = bad, "consumables.use.medica 가 정수 1~99 가 아니다", "개수 %s" % str(bad))
	_reject(s, func(d): d["state"].erase("consumables"), "consumables 가 객체가 아니다", "8판에 키 없음")
	_reject(s, func(d): d["state"]["consumables"] = [], "consumables 가 객체가 아니다", "배열")
	_reject(s, func(d): d.merge({"schema": 7, "rules": "m3i"}, true), "규칙 판(rules)이 schema 7 와 맞지 않다", "7판 머리에 m3i")
	var ok: Dictionary = JSON.parse_string(SaveCodec.encode(s))
	ok["state"]["consumables"]["use.medica"] = 99.0
	check(SaveCodec.decode(JSON.stringify(ok), s.defs).ok(), "99 는 받는다(정수와 같은 실수)")


