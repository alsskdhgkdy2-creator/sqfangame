## M-S2(migrate_v7 갈래가 없음)·M-G12(읽기의 60칸 합계 검사): 넷 모두 8판으로 옮겨지고 원래 필드는 그대로.
func test_fixed_v7_strings_migrate() -> void:
	var defs := Fx.arbor()
	for x in [["7판 마을", V7_TOWN, "town", 3], ["7판 전투", V7_BATTLE, "labyrinth", 2], ["7판 전멸", V7_WIPED, "labyrinth", 4], ["7판 넘친 가방", V7_OVER, "town", 5]]:
		var r := _check_kept(x[0], x[1], defs)
		if r.ok():
			check_eq([r.state.location, r.state.day], [x[2], x[3]], "%s: 장소·날" % x[0])
	var town := SaveCodec.decode(V7_TOWN, defs).state
	check_eq([town.key_items, town.floor_states.keys().size(), town.annotation.memos.values(), town.money], [{"key.moss_card": true, "key.relay_fuse": true}, 3, ["입구"], 480], "7판 마을: 열쇠 둘·세 층·메모·소지금")
	var bat := SaveCodec.decode(V7_BATTLE, defs).state
	check(bat.encounter.pending and bat.battle != null and bat.floor_def.id == "b2f", "7판 전투: B2F 전투 그대로")
	var bad: Dictionary = JSON.parse_string(V7_TOWN)
	bad["state"]["key_items"] = ["key.nope"]
	var rb := SaveCodec.decode(JSON.stringify(bad), defs)
	check(not rb.ok() and rb.error.begins_with("7판 검사 실패: "), "7판 검사가 그대로 돈다: %s" % rb.error)


## §3.3: 75개 넘친 옛 가방은 그대로 읽히고 얻는 길은 모두 막히며, 팔면 빈 칸이 생긴다. 9판 왕복도 75 그대로.
func test_over_capacity_v7_save_is_kept_and_blocks_gains() -> void:
	var s := SaveCodec.decode(V7_OVER, Fx.arbor()).state
	check_eq([BagRules.used(s), BagRules.free_slots(s), s.materials, s.gear_bag], [75, 0, {RAT: 40, GLOW: 20}, {TWIN: 10, PADDED: 5}], "75칸 그대로·빈 칸 0")
	var r := SaveCodec.decode(SaveCodec.encode(s), s.defs)
	check(r.ok() and BagRules.used(r.state) == 75 and r.from_schema == 10, "10판 왕복도 75 %s" % r.error)
	check_eq(ShopRules.buy(s, JUNK, "use.medica", 1)[0].get("reason"), "bag_full", "사기: bag_full")
	check_eq(GrowthRules.equip(s, 0, 2, "")[0].get("reason"), "bag_full", "빼기: bag_full")
	check_eq(GrowthRules.supply(s, "use.medica", 1)[0]["amount"], 0, "보급: 0")
	check_eq(BagRules.fit(s, RAT, 1), 0, "드롭·상자 입구(fit): 0")
	check_eq(ShopRules.sell(s, JUNK, [{"item": GLOW, "qty": 20}])[0]["type"], "sold", "팔기는 된다")
	check_eq([BagRules.used(s), BagRules.free_slots(s), BagRules.fit(s, "use.medica", 99)], [55, 5, 5], "55칸: 다섯 자리(수량 창의 최대)")
	check_eq(ItemRules.discard(s, TWIN, 10)[0]["left"], 0, "버리기도 된다")
	check_eq(BagRules.used(s), 45, "45칸")


