## .bak 이 7판이면(본 파일이 깨짐) .bak 을 8판으로 옮겨 읽는다.
func test_v7_bak_recovers() -> void:
	Fx.clean_saves()
	var store := SaveStore.new(Fx.arbor(), Fx.SAVE_DIR)
	DirAccess.make_dir_recursive_absolute(Fx.SAVE_DIR)
	var main := store.main_path("auto")
	var f := FileAccess.open(main, FileAccess.WRITE)
	f.store_string("{broken")
	f.close()
	f = FileAccess.open(main.get_basename() + ".bak", FileAccess.WRITE)
	f.store_string(V7_TOWN)
	f.close()
	var l := store.load_slot("auto")
	check(l.ok() and l.source_kind == "bak" and l.result.from_schema == 7 and not l.result.relocated, "7판 .bak 으로 되살림 %s" % str(l.failures))
	if l.ok():
		check_eq([l.result.generation, l.result.state.day, l.result.state.consumables], [81, 3, {}], "generation·날·빈 소모품")
	Fx.clean_saves()


