func _town() -> ExplorationState:
	var s := ExplorationRules.new_game(Fx.arbor(), 9, "full", true)
	s.encounter.threshold = 99999
	return s


## 마을: 첫 임무 보고(허가), 이끼 수프 받음(이끼 1), B2F 를 다녀와 나방 소탕 받음(2/4), 3일째.
func _quest_town() -> ExplorationState:
	var s := _town()
	QuestRules.accept(s, M1, "council")
	s.quests.entry(M1).progress = 1
	var rep := QuestRules.report(s, M1, "council")
	assert(rep.back()["type"] == "quest_reported", str(rep))
	s.day = 3
	QuestRules.accept(s, SOUP, "pub")
	BagRules.add(s, "item.neon_moss", 1)
	s.enter_floor(s.defs.floors["b2f"])
	var first := s.defs.first_floor()
	s.enter_floor(first)
	s.party.at = first.start_at
	s.party.facing = first.start_facing
	QuestRules.accept(s, MOTH, "pub")
	s.quests.entry(MOTH).progress = 2
	return s


func _reject(s: ExplorationState, mutate: Callable, needle: String, label: String) -> void:
	var doc: Dictionary = JSON.parse_string(SaveCodec.encode(s))
	mutate.call(doc)
	var r := SaveCodec.decode(JSON.stringify(doc), s.defs)
	check(not r.ok() and r.state == null, "%s: 거부되어야 한다" % label)
	check(r.error.contains(needle), "%s: 이유 '%s' 기대, 실제 '%s'" % [label, needle, r.error])


func _qd(d: Dictionary) -> Dictionary:
	return d["state"]["quests"]


## S1 (M-S-hash 쓰기가 quests 를 빠뜨림, M-S1 읽기가 progress 를 버림): 12판 문서 모양과 왕복.
func test_v12_roundtrip() -> void:
	var s := _quest_town()
	var doc: Dictionary = JSON.parse_string(SaveCodec.encode(s))
	check_eq([doc["schema"], doc["rules"]], [12.0, "m3q"], "12판 머리")
	check_eq(_qd(doc), {
		M1: {"status": "reported", "progress": 0.0, "reports": 1.0, "day": 1.0},
		SOUP: {"status": "accepted", "progress": 0.0, "reports": 0.0, "day": 0.0},
		MOTH: {"status": "accepted", "progress": 2.0, "reports": 0.0, "day": 0.0}}, "quests: 의뢰 ID → status·progress·reports·day")
	check_eq(doc["state"]["flags"], ["permit.b2f"], "flags: 정렬한 배열")
	var r := SaveCodec.decode(SaveCodec.encode(s), s.defs)
	check(r.ok(), "읽기 %s" % r.error)
	if r.ok():
		check_eq([SaveCodec.state_hash(r.state), r.from_schema], [SaveCodec.state_hash(s), 12], "같은 해시, 12판")
		check_eq([QuestRules.status_of(r.state, s.defs.quests.quests[MOTH]), QuestRules.progress_of(r.state, s.defs.quests.quests[MOTH]),
			QuestRules.status_of(r.state, s.defs.quests.quests[M1]), r.state.flags], ["accepted", 2, "finished", {"permit.b2f": true}], "읽은 의뢰 상태·진행·플래그")
	var t := ExplorationRules.new_game(Fx.defs(), 9, "full", true)
	var td: Dictionary = JSON.parse_string(SaveCodec.encode(t))
	check_eq([td["state"]["quests"], td["state"]["flags"]], [{}, []], "시험 묶음: 빈 quests·flags")
	var changed := _quest_town()
	changed.quests.entry(MOTH).progress = 3
	check(SaveCodec.state_hash(changed) != SaveCodec.state_hash(s), "진행이 다르면 해시가 다르다")


## S2 (M-S2 status 를 보지 않음, M-S3 deliver progress 를 받음, M-S4 반복 없는 reports 2 를 받음, M-S5 day 를 보지 않음,
## M-S6 잠긴 의뢰의 받음을 받음, M-S7 모르는 플래그를 받음, M-S11 보고한 임무의 보수 플래그가 없어도 받음, M-S12 식는 중에 다시 받은 기록을 받음):
## 12판 엄격 검사.
func test_v12_rejects() -> void:
	var s := _quest_town()
	_reject(s, func(d): _qd(d)["quest.nope"] = {"status": "accepted", "progress": 0, "reports": 0, "day": 0}, "quests 의 quest.nope 는 모르는 의뢰다", "모르는 의뢰")
	_reject(s, func(d): _qd(d)[SOUP]["x"] = 1, "quests.quest.moss_soup.x 는 모르는 필드다", "모르는 키")
	_reject(s, func(d): _qd(d)[SOUP].erase("day"), "quests.quest.moss_soup.day 가 없다", "키 없음")
	_reject(s, func(d): _qd(d)[SOUP]["status"] = "done", "status 는 accepted·reported", "status done")
	_reject(s, func(d): _qd(d)[SOUP]["progress"] = 1, "progress 는 정수 0~0", "deliver progress 1")
	_reject(s, func(d): _qd(d)[MOTH]["progress"] = 5, "progress 는 정수 0~4", "progress 목표 위")
	_reject(s, func(d): _qd(d)[MOTH]["progress"] = 1.5, "progress 는 정수", "progress 1.5")
	_reject(s, func(d): _qd(d)[M1]["progress"] = 1, "progress 는 정수 0~0", "reported 인데 progress 1")
	_reject(s, func(d): _qd(d)[M1]["reports"] = 0, "reports 가 상태·반복과 맞지 않다", "reported 인데 reports 0")
	_reject(s, func(d): _qd(d)[M1]["reports"] = 2, "reports 가 상태·반복과 맞지 않다", "반복 없는 reports 2")
	_reject(s, func(d): _qd(d)[MOTH]["reports"] = 1, "reports 가 상태·반복과 맞지 않다", "반복 없는 받은 의뢰 reports 1")
	_reject(s, func(d): _qd(d)[M1]["reports"] = true, "reports 가 상태·반복과 맞지 않다", "reports true")
	_reject(s, func(d): _qd(d)[M1]["day"] = 4, "day 는 정수 0~3", "day 가 오늘 뒤")
	_reject(s, func(d): _qd(d)[M1]["day"] = 0, "보고한 적이 없을 때만 0", "보고했는데 day 0")
	_reject(s, func(d): _qd(d)[SOUP]["day"] = 2, "보고한 적이 없을 때만 0", "보고 안 했는데 day 2")
	_reject(s, func(d): _qd(d)[RAM] = {"status": "accepted", "progress": 0, "reports": 0, "day": 0}, "quests.quest.ether_ram 를 받았는데 발급 조건이 맞지 않다", "잠긴 의뢰를 받음")
	_reject(s, func(d): d["state"]["flags"] = ["permit.nope"], "flags 의 permit.nope 는 모르는 플래그다", "모르는 플래그")
	_reject(s, func(d): d["state"]["flags"] = ["permit.b2f", "permit.b2f"], "flags 에 permit.b2f 가 두 번 있다", "플래그 둘")
	_reject(s, func(d): d["state"].erase("quests"), "quests 가 없다", "quests 없음")
	_reject(s, func(d): d["state"]["quests"] = [], "quests 는 사전이어야 한다", "quests 배열")
	_reject(s, func(d): d["state"]["flags"] = {}, "flags 는 배열이어야 한다", "flags 사전")
	_reject(s, func(d): d["state"].erase("flags"), "flags 가 없다", "flags 없음")
	var t := ExplorationRules.new_game(Fx.defs(), 9, "full", true)
	_reject(t, func(d): _qd(d)[SOUP] = {"status": "accepted", "progress": 0, "reports": 0, "day": 0}, "모르는 의뢰", "시험 묶음에 의뢰 기록")
	_reject(t, func(d): d["state"]["flags"] = ["permit.b2f"], "모르는 플래그", "시험 묶음에 플래그")
	_reject(s, func(d): d["schema"] = 13, "지원하지 않는 schema 다", "13판")
	_reject(s, func(d): d["rules"] = "m3r", "규칙 판(rules)이 schema 12 와 맞지 않다", "12판 머리에 m3r")
	# 검토(M3 A8a) 1: 보고한 임무는 보수 플래그를 가진다(첫 임무 permit.b2f, 둘째 임무 permit.boss). 반대(보고 없는 플래그)는 받는다.
	_reject(s, func(d): d["state"]["flags"] = [], "quests.mission.permit_b2f 를 보고했는데 보수 플래그 permit.b2f 가 없다", "첫 임무 보고, 허가 없음")
	_reject(s, func(d): _qd(d)[M2] = {"status": "reported", "progress": 0, "reports": 1, "day": 3},
		"quests.mission.boss_seal 를 보고했는데 보수 플래그 permit.boss 가 없다", "둘째 임무 보고, permit.boss 없음")
	var unreported: Dictionary = JSON.parse_string(SaveCodec.encode(s))
	unreported["state"]["flags"] = ["permit.b2f", "permit.boss"]
	var ur := SaveCodec.decode(JSON.stringify(unreported), s.defs)
	check(ur.ok() and ur.state.flags == {"permit.b2f": true, "permit.boss": true} and ur.state.quests.entry(M2) == null,
		"보고 없는 permit.boss 는 받는다(미궁 시작·이전과 같은 방향) %s" % ur.error)
	# 검토 3: 반복 의뢰를 다시 받은 기록은 다시 열린 날 이후(이끼 수프 days 1, 오늘 3일째).
	_reject(s, func(d): _qd(d)[SOUP] = {"status": "accepted", "progress": 0, "reports": 1, "day": 3},
		"quests.quest.moss_soup 를 다시 받았는데 아직 다시 열리지 않았다(4일째부터)", "3일째 보고 → 3일째 다시 받음")
	var opening: Dictionary = JSON.parse_string(SaveCodec.encode(s))
	_qd(opening)[SOUP] = {"status": "accepted", "progress": 0, "reports": 1, "day": 2}
	var orr := SaveCodec.decode(JSON.stringify(opening), s.defs)
	check(orr.ok() and orr.state.quests.entry(SOUP).reports == 1, "2일째 보고 → 3일째(여는 날 바로) 다시 받음은 받는다 %s" % orr.error)
	var ok: Dictionary = JSON.parse_string(SaveCodec.encode(s))
	_qd(ok)[MOTH]["progress"] = 2.0
	check(SaveCodec.decode(JSON.stringify(ok), s.defs).ok(), "progress 2.0 은 2 로 받는다")
	var lab := ExplorationRules.new_game(Fx.arbor(), 9, "full")
	var lr := SaveCodec.decode(SaveCodec.encode(lab), lab.defs)
	check(lr.ok() and lr.state.flags == {"permit.b2f": true}, "미궁 시작 상태(보고 없는 허가)도 저장 왕복이 된다 %s" % lr.error)


## S3 (M-S-mig 이전이 계단 허가를 붙이지 않음, M-S8 11판 이전이 필드를 바꿈): HEAD 로 만든 11판 고정 문서 → 12판.
## 원래 필드는 모두 그대로, quests 는 비고, flags 는 이미 내려간 층(B2F 기록)이 있으면 permit.b2f. 시험 묶음 문서를 게임 묶음으로 읽으면 옮기고 둘 다 빈다.
func test_fixed_v11_to_v12() -> void:
	var game := Fx.arbor()
	var test := Fx.defs()
	for x in [["V11_TOWN", V11_TOWN, game, ["permit.b2f"], "town"], ["V11_BATTLE", V11_BATTLE, game, ["permit.b2f"], "labyrinth"],
			["V11_CONTACT", V11_CONTACT, game, [], "labyrinth"], ["V11_WIPED", V11_WIPED, game, ["permit.b2f"], "labyrinth"], ["V11_TEST", V11_TEST, test, [], "labyrinth"]]:
		var orig: Dictionary = JSON.parse_string(x[1])
		var r := SaveCodec.decode(x[1], x[2])
		check(r.ok(), "%s: 읽기 %s" % [x[0], r.error])
		if not r.ok():
			continue
		check_eq([r.from_schema, r.relocated, r.saved_at, r.generation, r.state.location], [11, false, orig["saved_at"], int(orig["generation"]), x[4]],
			"%s: 11판·옮김 없음·saved_at·generation·장소" % x[0])
		var now := SaveCodec.state_to_dict(r.state)
		check_eq([now["quests"], now["flags"]], [{}, x[3]], "%s: 빈 quests, flags %s" % [x[0], str(x[3])])
		var sv := Fx.strip_v12(now, x[2])
		check_eq(sv["bad"], "", "%s: 더한 12판 값은 옮긴 값" % x[0])
		var o: Dictionary = orig["state"]
		for k in o:
			check_eq(V7._norm(sv["state"][k]), V7._norm(o[k]), "%s: %s 보존" % [x[0], k])
		check_eq(sv["state"].keys().filter(func(k: String) -> bool: return not o.has(k)), [], "%s: 맨 위에 더한 필드는 quests·flags 뿐" % x[0])
		var doc: Dictionary = JSON.parse_string(SaveCodec.encode(r.state))
		var again := SaveCodec.decode(JSON.stringify(doc), x[2])
		check(doc["schema"] == 12.0 and again.ok() and again.from_schema == 12 and SaveCodec.state_hash(again.state) == SaveCodec.state_hash(r.state),
			"%s: 12판으로 쓰고 다시 읽기 같은 해시 %s" % [x[0], again.error])
	var rel := SaveCodec.decode(V11_TEST, game)
	check(rel.ok() and rel.relocated and rel.from_schema == 11 and rel.state.quests.entries.is_empty() and rel.state.flags.is_empty(),
		"11판 시험 층을 게임 묶음으로: 옮기고 quests·flags 는 빔 %s" % rel.error)
	var town := SaveCodec.decode(V11_TOWN, game).state
	if town != null:
		check_eq([town.guild.members.size(), town.guild.members[0].class_id, town.party.members[1].equip[0], town.day],
			[1, "class.rail_ranger", "equip.ion_saber", 3], "11판 마을: 길드·장비·날 그대로")
		check_eq(QuestRules.status_of(town, game.quests.quests[M1]), "available", "옮긴 마을: 허가는 있어도 첫 임무는 받을 수 있다(기록 없음)")
	var bat := SaveCodec.decode(V11_BATTLE, game).state
	check(bat != null and bat.battle != null and bat.floor_def.id == "b2f", "11판 전투: B2F 전투 그대로")


## S4 (조정자 조건 5, M-S9 전투 중 저장이 진행을 미리 셈): 나방 소탕을 받은 채 B1F 전투 한가운데 저장 → 읽기 → 끝내기.
## 저장에는 전투 전 진행(0), 읽은 상태로 끝내면 정확히 한 번 센다(원래 상태로 끝낸 것과 같은 해시).
func test_battle_save_with_kill_quest() -> void:
	var s := _quest_town()
	s.quests.entry(MOTH).progress = 0
	ExplorationRules.apply(s, ExplorationRules.Action.ENTER, "full")
	s.encounter.danger = s.encounter.threshold  # 인카운트 전투 저장은 위험도 ≥ 한계값이어야 한다
	var st := BattleRules.start(s, "formation.b1.rats_moth")
	check_eq(st[0]["type"], "battle_start", "준비: 나방 한 마리 무리")
	var ev: Array[Dictionary] = []
	BattleRules.damage_unit(s, s.battle.enemies[2], s.battle.enemies[2].hp, s.battle.party[0], "bash", "attack", ev, {})
	var mid := SaveCodec.encode(s)
	check_eq(JSON.parse_string(mid)["state"]["quests"][MOTH]["progress"], 0.0, "전투 중 저장: 진행 0(전투 끝에만 센다)")
	var r := SaveCodec.decode(mid, s.defs)
	check(r.ok() and r.state.battle != null, "전투 중 저장 읽기 %s" % r.error)
	if not r.ok():
		return
	for x in [s, r.state]:
		var st2: ExplorationState = x
		for i in [0, 1]:
			BattleRules.damage_unit(st2, st2.battle.enemies[i], st2.battle.enemies[i].hp, st2.battle.party[0], "bash", "attack", ev, {})
		var fe: Array[Dictionary] = []
		BattleRules.finish(st2, "victory", fe)
		QuestRules.observe(st2, fe)
	check_eq([s.quests.entry(MOTH).progress, r.state.quests.entry(MOTH).progress], [1, 1], "끝낸 뒤 둘 다 1(겹치거나 잃지 않는다)")
	check_eq(SaveCodec.state_hash(r.state), SaveCodec.state_hash(s), "읽은 상태로 끝낸 것과 원래 상태로 끝낸 것이 같다")


## S5 (M-S10 지도 남기기가 의뢰를 옮김): 전멸 뒤 「지도를 남긴다」는 지도만 옮기고 대상의 의뢰·플래그는 그대로다.
func test_keep_map_keeps_target_quests() -> void:
	var target := _town()
	var wiped := _quest_town()
	TownRules.keep_map(target, wiped)
	check_eq([target.quests.entries.size(), target.flags], [0, {}], "대상의 빈 의뢰·플래그 그대로")
